# Behind a TLS-terminating edge (e.g. Render), keep the browser's original scheme.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

# The browser's IP: from the edge (Render/Cloudflare sets CF-Connecting-IP and rejects client
# values), or the direct peer when there is no edge (local compose).
map $http_cf_connecting_ip $mb_client_ip {
  default $http_cf_connecting_ip;
  ''      $remote_addr;
}

# Link-preview bots (WhatsApp, Facebook, X, LinkedIn, Telegram…) do not run JavaScript, so
# they get a small page from the API with the shared page's title, description and photo.
# Search engines are not listed: they render the app like a browser.
map $http_user_agent $link_preview_bot {
  default 0;
  "~*(facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|pinterest|skypeuripreview|redditbot|embedly|applebot)" 1;
}

# CANONICAL_HOST (e.g. mandapambooking.in): visits that arrive at the hosting platform's own
# address (*.onrender.com) are sent to the real domain, so nobody browses around the domain's
# edge protection. Kept open: payment webhooks (the gateway may still call the old address;
# it does not follow redirects) and /healthz (the platform's health check). Empty = off.
map "$host|$uri|${CANONICAL_HOST}" $canonical_redirect {
  default "";
  "~*^[^|]+\.onrender\.com\|(?!/api/v1/payments/webhooks/|/healthz\|)[^|]*\|(?<canon>[^|]+)$" $canon;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 1m;

  if ($canonical_redirect) {
    return 301 https://$canonical_redirect$request_uri;
  }

  # For the hosting platform's health check (kept open by the redirect above).
  location = /healthz {
    access_log off;
    add_header Cache-Control "no-store";
    return 200 "ok\n";
  }

  # Same-origin API proxy keeps the refresh cookie SameSite=Strict-friendly.
  # API_UPSTREAM may be internal (http://api:4000) or a public https URL (a host without
  # private networking, e.g. Render's free tier). Host is the upstream's own name, so
  # host-routed platforms reach the API rather than this web service; the browser's host is
  # passed along as X-Forwarded-Host. https upstreams get SNI and a verified certificate.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Request-Id $request_id;
    # The API trusts X-MB-Client-IP only when this secret matches its PROXY_SHARED_SECRET, so
    # nobody calling the API directly can forge it. Set it only behind an edge like Render's.
    proxy_set_header X-MB-Client-IP $mb_client_ip;
    proxy_set_header X-MB-Proxy-Secret "${PROXY_SHARED_SECRET}";
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
  }

  # Hashed bundles can be cached forever.
  location ~* \.(?:js|css|woff2?|png|jpg|jpeg|webp|svg|ico)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri =404;
  }

  # Built by the API: it knows the site address and the live venues.
  location = /robots.txt {
    rewrite ^ /api/v1/seo/robots.txt last;
  }
  location = /sitemap.xml {
    rewrite ^ /api/v1/seo/sitemap.xml last;
  }

  location / {
    if ($link_preview_bot) {
      rewrite ^ /api/v1/seo/share?path=$uri? last;
    }
    add_header Cache-Control "no-cache";
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri $uri/ /index.html;
  }
}
