# Behind a TLS-terminating edge (e.g. Render), keep the browser's original scheme.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 1m;

  # Same-origin API proxy keeps the refresh cookie SameSite=Strict-friendly.
  # API_UPSTREAM may be internal (http://api:4000) or a public https URL (a host without
  # private networking, e.g. Render's free tier). Host is the upstream's own name, so
  # host-routed platforms reach the API rather than this web service; the browser's host is
  # passed along as X-Forwarded-Host. https upstreams get SNI and a verified certificate.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
  }

  # Hashed bundles can be cached forever.
  location ~* \.(?:js|css|woff2?|png|jpg|jpeg|webp|svg|ico)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri $uri/ /index.html;
  }
}
