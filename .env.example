# Copy to .env for local development. Never commit .env.
# Every value here is a local-only placeholder; generate real secrets per environment.

# --- API ---
NODE_ENV=development
# Deployed only, with NODE_ENV=production: "staging" keeps every production safeguard but
# allows the mock payment gateway and Razorpay test keys. Unset means strict production.
# APP_ENV=staging
PORT=4000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
# Behind an edge that sets the client IP itself (Render/Cloudflare): use that header instead
# of counting hops, and share PROXY_SHARED_SECRET with the web nginx. See docs/runbook.md.
# CLIENT_IP_HEADER=cf-connecting-ip
# PROXY_SHARED_SECRET=
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
BODY_LIMIT=100kb
# Maintenance sweeps (holds, completion, refunds, email, payouts): every N seconds, in the
# worker (`node dist/worker.js`, same image as the API), or in the API itself when
# RUN_JOBS_IN_PROCESS=true (for hosts without a free worker tier, e.g. Render).
SWEEP_INTERVAL_SECONDS=30
RUN_JOBS_IN_PROCESS=false

# --- PostgreSQL (docker compose publishes it on localhost:5433) ---
POSTGRES_DB=mandapambook
POSTGRES_USER=mandapambook
POSTGRES_PASSWORD=change-me-local-db-password
# Pooled URL for the app. For Neon use the "-pooler" host and append ?sslmode=verify-full
DATABASE_URL=postgres://mandapambook:change-me-local-db-password@localhost:5433/mandapambook
# Direct (non-pooled) URL for migrations. Defaults to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgres://mandapambook:change-me-local-db-password@localhost:5433/mandapambook
# Database used by integration tests. Its name MUST end in _test: tests drop and recreate its schema.
TEST_DATABASE_URL=postgres://mandapambook:change-me-local-db-password@localhost:5433/mandapambook_test

# --- Redis (docker compose publishes it on localhost:6380) ---
REDIS_PASSWORD=change-me-local-redis-password
REDIS_URL=redis://:change-me-local-redis-password@localhost:6380
# Optional namespace for all Redis keys (e2e runs set their own).
# REDIS_KEY_PREFIX=
# Hosted alternative (Upstash, TLS): REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379

# --- Object storage (any S3-compatible store: Neon storage, AWS S3, R2, SeaweedFS on :8333) ---
# memory = in-process, for tests/offline dev only (refused in production)
STORAGE_PROVIDER=s3
# Neon: https://<branch-id>.storage.<region>.aws.neon.tech
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=mandapambook
S3_SECRET_ACCESS_KEY=change-me-local-s3-secret
S3_BUCKET=mandapambook-media

# --- Auth (generate real values with: node scripts/generate-secrets.mjs) ---
APP_BASE_URL=http://localhost:4200
# Key rings: "kid:base64url-secret,..." First key signs; all keys verify. Each >= 32 bytes.
ACCESS_TOKEN_KEYS=a1:change-me-generate-with-scripts-generate-secrets
REFRESH_TOKEN_KEYS=r1:change-me-generate-with-scripts-generate-secrets
CSRF_SECRET=change-me-generate-with-scripts-generate-secrets
OTP_SECRET=change-me-generate-with-scripts-generate-secrets
# AES-256-GCM keys for PAN and bank details. Each exactly 32 bytes. First key encrypts.
FIELD_ENCRYPTION_KEYS=f1:change-me-generate-with-scripts-generate-secrets
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
HIBP_ENABLED=false
# "Continue with Google" (Google Cloud Console > APIs & Services > Credentials > OAuth client,
# type Web application). Authorised redirect URI: APP_BASE_URL + /api/v1/auth/google/callback
# Leave both empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# console logs emails (development). smtp sends through SMTP_URL; required in production.
EMAIL_PROVIDER=console
# Mailpit (docker compose): smtp://localhost:1025. Production: smtps://user:pass@relay:465
# SMTP_URL=smtp://localhost:1025
EMAIL_FROM=MandapamBook <no-reply@mandapambook.example>
# Optional: gets a copy of every new booking, cancellation and refund (blank = none)
ADMIN_NOTIFY_EMAIL=
# Optional: when the SMTP key expires (YYYY-MM-DD); weekly reminders start 30 days before
SMTP_KEY_EXPIRES_AT=
# Optional: Sentry DSNs for error tracking (blank = off)
SENTRY_DSN=
SENTRY_WEB_DSN=
OTP_PROVIDER=console

# --- Redis for integration tests (optional locally; tests fall back to in-memory stores) ---
# For Upstash use the TCP URL: rediss://default:<password>@<name>.upstash.io:6379
TEST_REDIS_URL=

# Optional (dev only): password for demo accounts of every role created by db:seed
SEED_DEMO_PASSWORD=

# --- Payments (see docs/payments-migration.md) ---
# Keep exactly ONE of the three blocks below active; comment out (#) the other two.
# rzp_test_ keys = no real money (TEST MODE banner and a "test payments only" note at Pay).
# PAYMENTS_MODE=test (the default) refuses to start if ANY setting holds an rzp_live_ key.
# Real payments need PAYMENTS_MODE=live, live keys, and real production (never staging).
PAYMENTS_MODE=test

# Search engines: false = robots.txt blocks everything and the sitemap is empty. The web
# image's ROBOTS_TAG="noindex, nofollow" adds the matching header to every page.
SEO_INDEXING=true

# 1) Built-in fake gateway: no Razorpay account needed (local development only)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_KEY_SECRET=change-me-generate-with-scripts-generate-secrets
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-generate-with-scripts-generate-secrets

# 2) Razorpay TEST mode: Razorpay dashboard with "Test Mode" ON → API Keys, Webhooks
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# 3) Razorpay LIVE mode (REAL MONEY): Test Mode OFF, after KYC → API Keys, Webhooks
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- End-to-end tests (pnpm e2e) ---
# Separate database whose name ends in _e2e; it is wiped at the start of every run.
# E2E_DATABASE_URL=postgres://user:pass@localhost:5432/mandapambook_e2e
