# Copy to .env for local development. Never commit .env.
# Every value here is a local-only placeholder; generate real secrets per environment.

# --- API ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
BODY_LIMIT=100kb

# --- PostgreSQL (docker compose publishes it on localhost:5433) ---
POSTGRES_DB=mandapambook
POSTGRES_USER=mandapambook
POSTGRES_PASSWORD=change-me-local-db-password
# Pooled URL for the app. For Neon use the "-pooler" host and append ?sslmode=verify-full
DATABASE_URL=postgres://mandapambook:change-me-local-db-password@localhost:5433/mandapambook
# Direct (non-pooled) URL for migrations. Defaults to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgres://mandapambook:change-me-local-db-password@localhost:5433/mandapambook
# Database used by integration tests. Its name MUST end in _test: tests drop and recreate its schema.
TEST_DATABASE_URL=postgres://mandapambook:change-me-local-db-password@localhost:5433/mandapambook_test

# --- Redis (docker compose publishes it on localhost:6380) ---
REDIS_PASSWORD=change-me-local-redis-password
REDIS_URL=redis://:change-me-local-redis-password@localhost:6380
# Hosted alternative (Upstash, TLS): REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379

# --- Object storage (SeaweedFS S3 locally on :8333, any S3-compatible store in cloud) ---
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=mandapambook
S3_SECRET_ACCESS_KEY=change-me-local-s3-secret
S3_BUCKET=mandapambook-media

# --- Auth (generate real values with: node scripts/generate-secrets.mjs) ---
APP_BASE_URL=http://localhost:4200
# Key rings: "kid:base64url-secret,..." First key signs; all keys verify. Each >= 32 bytes.
ACCESS_TOKEN_KEYS=a1:change-me-generate-with-scripts-generate-secrets
REFRESH_TOKEN_KEYS=r1:change-me-generate-with-scripts-generate-secrets
CSRF_SECRET=change-me-generate-with-scripts-generate-secrets
OTP_SECRET=change-me-generate-with-scripts-generate-secrets
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
HIBP_ENABLED=false
EMAIL_PROVIDER=console
OTP_PROVIDER=console

# --- Redis for integration tests (optional locally; tests fall back to in-memory stores) ---
# For Upstash use the TCP URL: rediss://default:<password>@<name>.upstash.io:6379
TEST_REDIS_URL=

# Optional (dev only): password for demo accounts of every role created by db:seed
SEED_DEMO_PASSWORD=
